{
    "name": "ivupcn/restina",
    "description": "A lightweight PHP framework",
    "type": "library",
    "keywords": ["php", "framework", "api", "restful", "eloquent", "orm"],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "ivup.cn",
            "email": "ivup@ivup.cn",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ivupcn/restina-framework",
    "support": {
        "issues": "https://github.com/ivupcn/restina-framework/issues",
        "source": "https://github.com/ivupcn/restina-framework"
    },
    "require": {
        "php": "^8.4",
        "nyholm/psr7": "^1.8",
        "psr/log": "^3.0.0",
        "php-di/php-di": "^7.1",
        "psr/http-message": "^2.0",
        "illuminate/database": "^12.49",
        "illuminate/events": "^12.49",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Restina\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
